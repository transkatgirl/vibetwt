# Copy to .env and fill in. Values come from your app at https://console.x.com

# OAuth 2.0 client ID (required).
X_CLIENT_ID=

# OAuth 2.0 client secret. Only needed if your app is a "confidential client".
X_CLIENT_SECRET=

# App-only bearer token, used to open the activity stream (required).
X_BEARER_TOKEN=

# Must exactly match a callback URL registered on your X app.
X_REDIRECT_URI=http://127.0.0.1:8976/callback

# Intiface Central's server address.
BUTTPLUG_URL=ws://127.0.0.1:12345
